    {
      "id": "mongo-200",
      "type": "text",
      "x": 2604,
      "y": 3015,
      "width": 888,
      "height": 189,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 17200,
      "version": 2,
      "versionNonce": 1979551773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793352497275,
      "link": null,
      "locked": false,
      "text": "CsvImportService escribe MongoDB y luego sincroniza Neo4j.\nSHA-256, upsert y MERGE permiten repetir una carga sin duplicar.\nSi falla Neo4j, la carga queda como PENDIENTE_NEO4J.\nLa aplicación no implementa una transacción distribuida.\n\nM06 se recalcula desde evaluaciones al consultar el dashboard.\nCon filtros devuelve resultados sin escribir la colección resumen_carrera.",
      "originalText": "CsvImportService escribe MongoDB y luego sincroniza Neo4j.\nSHA-256, upsert y MERGE permiten repetir una carga sin duplicar.\nSi falla Neo4j, la carga queda como PENDIENTE_NEO4J.\nLa aplicación no implementa una transacción distribuida.\n\nM06 se recalcula desde evaluaciones al consultar el dashboard.\nCon filtros devuelve resultados sin escribir la colección resumen_carrera.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b2Y"
    }
