    },
    {
      "id": "mongo-196",
      "type": "text",
      "x": 1344,
      "y": 3015,
      "width": 828,
      "height": 189,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 17196,
      "version": 2,
      "versionNonce": 292225885,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793352497275,
      "link": null,
      "locked": false,
      "text": "Backend: ApiExceptionHandler → ApiErrorResponse.\nCliente: apiErrorInterceptor adapta errores HTTP para las vistas.\nLos DTO/records definen entradas y salidas; no son servicios.\nAnalysisFilters recibe los parámetros de los análisis MongoDB.\n\nLos componentes de presentación reciben datos para dibujar o mostrar.\nLas credenciales y el acceso a ambos motores están en el backend.",
      "originalText": "Backend: ApiExceptionHandler → ApiErrorResponse.\nCliente: apiErrorInterceptor adapta errores HTTP para las vistas.\nLos DTO/records definen entradas y salidas; no son servicios.\nAnalysisFilters recibe los parámetros de los análisis MongoDB.\n\nLos componentes de presentación reciben datos para dibujar o mostrar.\nLas credenciales y el acceso a ambos motores están en el backend.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b2U"
    },
