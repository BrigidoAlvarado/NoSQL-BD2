      "seed": 17090,
      "version": 2,
      "versionNonce": 53421162,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793351015971,
      "link": null,
      "locked": false,
      "text": "Municipio.clave = SHA-256(departamento + U+001F + municipio).\nProcedenciaEducativa.clave = SHA-256(tipo + U+001F + departamento + U+001F + municipio).\nLas categorías conservan el texto original. «SIN DATOS» se conserva con bandera de desconocido.\nLa edad es anioIngreso − anioNacimiento; se omite si falta el año o si queda fuera de 0–100.",
      "originalText": "Municipio.clave = SHA-256(departamento + U+001F + municipio).\nProcedenciaEducativa.clave = SHA-256(tipo + U+001F + departamento + U+001F + municipio).\nLas categorías conservan el texto original. «SIN DATOS» se conserva con bandera de desconocido.\nLa edad es anioIngreso − anioNacimiento; se omite si falta el año o si queda fuera de 0–100.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b0R"
    },
    {
      "id": "mongo-091",
      "type": "rectangle",
