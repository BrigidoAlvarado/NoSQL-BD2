    {
      "id": "mongo-090",
      "type": "text",
      "x": 96,
      "y": 1840,
      "width": 1140,
      "height": 108,
      "angle": 0,
      "strokeColor": "#53657d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
