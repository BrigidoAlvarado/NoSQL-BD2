      "seed": 17115,
      "version": 2,
      "versionNonce": 787413837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793351880531,
      "link": null,
      "locked": false,
      "text": "Rectángulo con pestañas: componente de software.\nLímite discontinuo: entorno de ejecución o nodo.\nFlecha discontinua «use»: dependencia hacia el proveedor.\nActor: usuario. Símbolo cilíndrico: base de datos.\n\nLa comunicación HTTP incluye solicitud y respuesta JSON.\nVista local actual; el despliegue de producción está pendiente.",
      "originalText": "Rectángulo con pestañas: componente de software.\nLímite discontinuo: entorno de ejecución o nodo.\nFlecha discontinua «use»: dependencia hacia el proveedor.\nActor: usuario. Símbolo cilíndrico: base de datos.\n\nLa comunicación HTTP incluye solicitud y respuesta JSON.\nVista local actual; el despliegue de producción está pendiente.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b0c"
