    {
      "id": "mongo-111",
      "type": "text",
      "x": 1164,
      "y": 1735,
      "width": 792,
      "height": 189,
      "angle": 0,
      "strokeColor": "#172b4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 17111,
      "version": 2,
      "versionNonce": 877427341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793351880531,
      "link": null,
      "locked": false,
      "text": "Controlador: recibe HTTP. Servicio: coordina el caso de uso.\nConsulta: obtiene datos. Conversor: prepara la respuesta.\nPersistencia: escribe documentos o nodos y relaciones.\n\nApiExceptionHandler devuelve errores controlados.\nAngular muestra el error y permite continuar o reintentar.\nCredenciales y configuración de los motores residen en el backend.",
      "originalText": "Controlador: recibe HTTP. Servicio: coordina el caso de uso.\nConsulta: obtiene datos. Conversor: prepara la respuesta.\nPersistencia: escribe documentos o nodos y relaciones.\n\nApiExceptionHandler devuelve errores controlados.\nAngular muestra el error y permite continuar o reintentar.\nCredenciales y configuración de los motores residen en el backend.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b0Y"
    },
