# Copia este archivo como .env y establece tus contraseñas antes de iniciar.
# MongoDB 8.0 y Neo4j 5.26 Community; pueden fijarse a un parche o digest.
MONGODB_IMAGE=mongo:8.0
MONGODB_PORT=27017
MONGODB_HOST=127.0.0.1
MONGODB_DATABASE=admisiones_usac
MONGODB_AUTH_DATABASE=admin
MONGODB_USERNAME=admisiones_admin
MONGODB_PASSWORD=CAMBIA_ESTA_CLAVE_MONGODB

NEO4J_IMAGE=neo4j:5.26-community
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HOST=127.0.0.1
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
# El usuario inicial de Neo4j es neo4j. Usa una contraseña de al menos 8 caracteres.
NEO4J_PASSWORD=CAMBIA_ESTA_CLAVE_NEO4J
